# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
game_logs/
build/
dist/
*.egg-info/
*.egg
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec.bak
warn-*.txt

# Installer artifacts
*.exe
*.dll
*.pyd
*.app
*.dmg
*.pkg
*.deb
*.rpm
*.msi
*.bat
*.sh

# PyQt UI files
*.ui
*.qrc

# Jupyter Notebook
.ipynb_checkpoints

# IDE and editor files
.vscode/
.idea/
.cursor/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Python virtual environments
.venv/
venv/
ENV/
env/
.ENV/
.env/

# Local env files
.env
.env.local
.env.production

# Config with secrets (use config.example.json as template)
config.json

# Logs and log directories
*.log
logs/
app.log

# Local history
login_history.json
ScoreAI_pages/login_history.json

# Build and installer output directories
installer_output/
16ScoreAI_Installer_Output/

# Documentation files (auto-generated by build script)
LICENSE.txt
INSTALL_INFO.txt
POST_INSTALL_INFO.txt

# Large model files (use Git LFS)
best_50.pt
*.pt
*.pth
*.onnx
*.h5
*.pb
!bestffmax.pt

# Free Fire runtime output (regenerated during live detection)
cropkillblock/*
!cropkillblock/.gitkeep
cropped_text/*
!cropped_text/.gitkeep
debug_capture/*
!debug_capture/.gitkeep
killfeed_crops/*
!killfeed_crops/.gitkeep
status_detected/*
!status_detected/.gitkeep

# Temporary and backup files
*.pyc
*.pyo
*.tmp
temp_*
*.backup
*.bak
*.swp
*.swo
*~# Auto-generated files
imported_modules.txt# Database files
*.db
*.sqlite
*.sqlite3